server {
    listen 80;
    root /usr/share/nginx/html;

    # SPA: любой неизвестный путь — это index.html, дальше разбирается React.
    location / {
        try_files $uri /index.html;
    }

    # API и служебные эндпоинты — на backend (BACKEND_URL подставляет образ nginx при старте).
    location ~ ^/(api|health|version) {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }
}
